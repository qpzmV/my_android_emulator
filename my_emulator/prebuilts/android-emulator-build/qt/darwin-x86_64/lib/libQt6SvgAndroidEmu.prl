QMAKE_PRL_TARGET = libQt6SvgAndroidEmu.dylib
QMAKE_PRL_CONFIG = shared
QMAKE_PRL_VERSION = 6.5.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6GuiAndroidEmu.dylib $$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib -framework IOKit -framework DiskArbitration -framework AppKit -framework ImageIO -framework Metal
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6GuiAndroidEmu.dylib;$$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib;-framework IOKit;-framework DiskArbitration;-framework AppKit;-framework ImageIO;-framework Metal
