QMAKE_PRL_TARGET = libQt6DBusAndroidEmu.dylib
QMAKE_PRL_CONFIG = shared
QMAKE_PRL_VERSION = 6.5.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib -framework IOKit -framework DiskArbitration
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib;-framework IOKit;-framework DiskArbitration
