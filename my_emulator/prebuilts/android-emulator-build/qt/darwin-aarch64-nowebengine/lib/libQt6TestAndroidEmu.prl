QMAKE_PRL_TARGET = libQt6TestAndroidEmu.dylib
QMAKE_PRL_CONFIG = shared
QMAKE_PRL_VERSION = 6.5.3
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib -framework DiskArbitration -framework Security -framework AppKit -framework ApplicationServices -framework Foundation -framework IOKit
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6CoreAndroidEmu.dylib;-framework DiskArbitration;-framework Security;-framework AppKit;-framework ApplicationServices;-framework Foundation;-framework IOKit
